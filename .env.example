# --- server (read by server/src/config/env.ts) ------------------------------
PORT=3000
NODE_ENV=development

DB_USER=postgres
DB_HOST=localhost
DB_NAME=cozy_apps
DB_PASSWORD="super-secret-password"
DB_PORT=5432

# Required. The server refuses to boot without these two.
JWT_SECRET=super-secret-jwt

GOOGLE_API_KEY=test

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- ui (read by Vite at build time; must be VITE_-prefixed) ----------------
# Where the browser sends API calls. Leave unset in dev to use the Vite proxy.
VITE_API_URL=http://localhost:3000
