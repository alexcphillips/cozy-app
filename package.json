{
    "name": "cozy-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "shared",
        "server",
        "ui"
    ],
    "scripts": {
        "dev": "npm run dev --workspace @cozy/server & npm run dev --workspace @cozy/ui; wait",
        "dev:ui": "npm run dev --workspace @cozy/ui",
        "dev:server": "npm run dev --workspace @cozy/server",
        "build": "npm run build --workspace @cozy/ui",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "eslint .",
        "verify": "npm run typecheck && npm run lint && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.48.0"
    }
}
