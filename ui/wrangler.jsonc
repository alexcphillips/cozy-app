{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "haileysbookshelf",
    "compatibility_date": "2026-07-27",
    "observability": {
        "enabled": true,
    },
    "assets": {
        "directory": "./ui/dist",
        "not_found_handling": "single-page-application",
    },
    "compatibility_flags": ["nodejs_compat"],
}
