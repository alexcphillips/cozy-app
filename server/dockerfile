FROM node:20-alpine

WORKDIR /usr/src/app

# Force production mode optimizations
ENV NODE_ENV=production

# 1. Copy the global and local package manifests together to map dependencies correctly
COPY package*.json ./
COPY server/package*.json ./server/

# Install dependencies globally first, then target production modules cleanly
RUN npm ci --include=dev && npm install -g tsx

# 2. Copy your server application code across
COPY server/ ./server/
COPY tsconfig*.json ./

# Expose your standard EC2 api listening channel
EXPOSE 8080

USER node

# Boots your TypeScript backend instantly using tsx directly from your server directory
CMD ["tsx", "server/src/index.ts"]
