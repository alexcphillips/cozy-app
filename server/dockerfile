# ==========================================
# STAGE 1: Compiles TypeScript -> JavaScript
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Copy dependency files relative to your root layout repository structure
COPY server/package*.json ./

# Install ALL packages (including TypeScript compiler engine)
RUN npm ci

# Copy the rest of your server code across
COPY server/ .

# Compiles everything down to static JS inside a /usr/src/app/dist folder
RUN npx tsc

# ==========================================
# STAGE 2: Lightweight Production Runner
# ==========================================
FROM node:20-alpine AS runner

WORKDIR /usr/src/app

# Force Node to drop development tracing blocks
ENV NODE_ENV=production

# Re-copy manifests to pull clean production-only modules
COPY server/package*.json ./
RUN npm ci --omit=dev

# PULL ONLY THE COMPILED JS (Ditches the compiler and raw TS code completely)
COPY --from=builder /usr/src/app/dist ./dist

# Expose the application network bridge
EXPOSE 8080

USER node

# Boots up your lightning-fast JavaScript file natively on Node
CMD ["node", "dist/index.js"]
